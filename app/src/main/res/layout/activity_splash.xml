<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_petroleo"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Ícone do Aplicativo -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_qr_code_logo"
            android:contentDescription="Logotipo Consulta Fácil"
            android:layout_marginBottom="16dp" />

        <!-- Nome do Aplicativo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consulta Fácil"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center" />

        <!-- Detalhe Visual Esmeralda -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/emerald_green"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <!-- Subtítulo / Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Identifique. Consulte. Organize."
            android:textSize="15sp"
            android:textColor="@color/emerald_light"
            android:gravity="center" />

    </LinearLayout>

    <ProgressBar
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
        android:indeterminateTint="@color/emerald_green" />

</RelativeLayout>
