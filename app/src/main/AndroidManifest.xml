<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atividade_2Bim_2Sem">

        <!-- Splash Screen Inicial -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Atividade_2Bim_2Sem">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity Principal (Home) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Activity de Leitura do QR Code Customizada -->
        <activity
            android:name=".CustomScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            tools:replace="android:screenOrientation" />

        <!-- Activity de Histórico Completo -->
        <activity
            android:name=".HistoricoActivity"
            android:exported="false"
            android:label="Histórico de Consultas"
            android:parentActivityName=".MainActivity" />

        <!-- Activity de Detalhes do Produto -->
        <activity
            android:name=".DetalhesActivity"
            android:exported="false"
            android:label="Detalhes do Produto"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>